function getTimestamp_(dayOffset) {

  // var dayOffset = -1

  var timeZoneOffset = 3; // Смещение часового пояса GMT+3 в минутах
  var now = new Date();
  now.setUTCHours(0, 0, 0, 0); // Устанавливаем время на начало дня по UTC
  var timestamp = Math.floor(now.getTime() / 1000) - (timeZoneOffset * 60 * 60) + (dayOffset * 24 * 60 * 60);
  //  console.log('timestamp: ' + timestamp + '\ndayOffset: ' + dayOffset)
  return timestamp;
}


function get_size_data_(data) {

  var blob = Utilities.newBlob(JSON.stringify(data)); // Создаем объект Blob из массива ячеек
  var sizeInBytes = blob.getBytes().length; // Получаем размер объекта Blob в байтах
  var sizeInKilobytes = (sizeInBytes / 1024).toFixed(2);
  var kilobytesNumber = parseFloat(sizeInKilobytes);
  console.log('Размер массива ячеек в Кб: ' + kilobytesNumber);

  return kilobytesNumber
}


function convertUnixTimeToNormalDate_(unixTime, includeTime) {

  if (unixTime != "") {
    if (
      (typeof unixTime === 'number') ||
      (Number(unixTime) > 1)
    ) {
      var date = new Date(unixTime * 1000); // Умножаем на 1000, так как Unix время в секундах, а Date работает с миллисекундами

      if (includeTime === 0) {
        // Возвращаем только дату без времени
        return date.toLocaleDateString('ru');
      } else {
        // Возвращаем дату и время
        return date.toLocaleString('ru');
      }
    } else {
      console.error('Это не число')
      return unixTime;
    }
  }
  else {
    return unixTime;
  }
}



function convertDateToUnixTime_(dateString) {
  // Если строка содержит точки (например, "24.09.2023"), преобразовываем её в стандартный формат
  if (dateString.includes('.')) {
    var parts = dateString.split('.');
    var day = parts[0];
    var month = parts[1];
    var otherParts = parts[2].split(',');  // Разделение года и времени
    var year = otherParts[0].trim();
    var time = otherParts[1].trim();
    dateString = year + '-' + month + '-' + day + ' ' + time;
  }

  var date = new Date(dateString);
  return Math.floor(date.getTime() / 1000);  // getTime возвращает миллисекунды, поэтому делим на 1000 для получения секунд
}


