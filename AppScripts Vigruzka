function upsertDealsById_(sheet, rows) {
  if (!rows || !rows.length) return;

  // ВАЖНО: считаем, что ID сделки у тебя в колонке A (index 0 в массиве)
  var ID_COL_INDEX = 0;
  var HEADER_ROWS = 1; // строка 1 — заголовки, данные с 2-й

  // Считываем все текущие ID из листа
  var lastRow = sheet.getLastRow();
  var existing = {};
  if (lastRow > HEADER_ROWS) {
    var ids = sheet.getRange(HEADER_ROWS + 1, 1, lastRow - HEADER_ROWS, 1).getValues(); // колонка A
    for (var i = 0; i < ids.length; i++) {
      var id = String(ids[i][0] || '').trim();
      if (id) existing[id] = HEADER_ROWS + 1 + i; // номер строки на листе
    }
  }

  // Разбиваем на обновления и новые
  var updates = []; // {rowNumber, values}
  var inserts = []; // values[]

  for (var r = 0; r < rows.length; r++) {
    var dealId = String(rows[r][ID_COL_INDEX] || '').trim();
    if (!dealId) continue;

    if (existing[dealId]) {
      updates.push({ rowNumber: existing[dealId], values: rows[r] });
    } else {
      inserts.push(rows[r]);
    }
  }

  // 1) Обновляем существующие (перезаписываем строку целиком) пачками последовательных строк
  if (updates.length) {
    updates.sort(function(a, b){ return a.rowNumber - b.rowNumber; });

    var start = updates[0].rowNumber;
    var batch = [updates[0].values];

    for (var u = 1; u < updates.length; u++) {
      var rn = updates[u].rowNumber;
      if (rn === start + batch.length) {
        batch.push(updates[u].values);
      } else {
        sheet.getRange(start, 1, batch.length, batch[0].length).setValues(batch);
        start = rn;
        batch = [updates[u].values];
      }
    }
    sheet.getRange(start, 1, batch.length, batch[0].length).setValues(batch);
  }

  // 2) Добавляем новые в конец
  if (inserts.length) {
    var startRow = sheet.getLastRow() + 1;
    sheet.getRange(startRow, 1, inserts.length, inserts[0].length).setValues(inserts);
  }
}



/*
 * This file contains the updated version of the original Apps Script used
 * for integrating with amoCRM and Google Sheets. It introduces several
 * improvements and safeguards to ensure that the authentication tokens
 * are handled more robustly and that long‑running processes do not leave
 * stale locks behind. The new helper functions make it possible to
 * recover gracefully when tokens are missing or expired.
 *
 * IMPORTANT: Before running this script for the first time after the
 * update, please add the following entries to the Script Properties via
 * the Apps Script project settings. These values correspond to your
 * amoCRM application credentials and the one‑time authorization code
 * used to obtain your initial refresh token:
 *
 *   AMO_CLIENT_ID        – your amoCRM client ID
 *   AMO_CLIENT_SECRET    – your amoCRM client secret
 *   AMO_REDIRECT_URI     – redirect URI registered in amoCRM (e.g. https://script.google.com/)
 *   AMO_AUTH_CODE        – the single‑use authorization code obtained during the OAuth flow
 *
 * The script will automatically exchange this code for a pair of
 * access/refresh tokens on first use and subsequently refresh the
 * access token using the stored refresh token.
 */

var scriptProperties = PropertiesService.getScriptProperties();

function getAmoCfg_() {
  function pickConst_(name) {
    try {
      if (name === 'SUBDOMAIN' && typeof SUBDOMAIN !== 'undefined') return SUBDOMAIN;
      if (name === 'CLIENT_ID' && typeof CLIENT_ID !== 'undefined') return CLIENT_ID;
      if (name === 'CLIENT_SECRET' && typeof CLIENT_SECRET !== 'undefined') return CLIENT_SECRET;
      if (name === 'REDIRECT_URI' && typeof REDIRECT_URI !== 'undefined') return REDIRECT_URI;
      if (name === 'AUTH_CODE' && typeof Code_authentication !== 'undefined') return Code_authentication;
    } catch (e) {}
    return null;
  }

  function pickProp_(keys) {
    for (var i = 0; i < keys.length; i++) {
      var v = scriptProperties.getProperty(keys[i]);
      if (v !== null && v !== undefined && String(v).trim() !== '') return String(v).trim();
    }
    return null;
  }

  return {
    subdomain: pickConst_('SUBDOMAIN') || pickProp_(['AMO_SUBDOMAIN', 'SUBDOMAIN']),
    clientId: pickConst_('CLIENT_ID') || pickProp_(['AMO_CLIENT_ID', 'CLIENT_ID']),
    clientSecret: pickConst_('CLIENT_SECRET') || pickProp_(['AMO_CLIENT_SECRET', 'CLIENT_SECRET']),
    redirectUri: pickConst_('REDIRECT_URI') || pickProp_(['AMO_REDIRECT_URI', 'REDIRECT_URI']),
    authCode: pickConst_('AUTH_CODE') || pickProp_(['AMO_AUTH_CODE', 'Code_authentication'])
  };
}


// const SUBDOMAIN = 'kitchencrm';

// -----------------------------------------------------------------------------
// Helper: Obtain a valid access token from properties or refresh it
//
// This function encapsulates the logic required to ensure that a valid
// Amo_Access_token is available. It tries the following in order:
//   1. If an access token exists, return it.
//   2. If an access token does not exist but a refresh token exists,
//      attempt to refresh the access token. If successful, return it.
//   3. If neither token exists, use the one‑time AMO_AUTH_CODE stored in
//      script properties to perform the initial OAuth exchange. The
//      resulting access and refresh tokens are saved to the standard
//      properties (Amo_Access_token and Amo_Refresh_token). The function
//      then returns the new access token.
//
// If the authorization code is invalid or has expired, an error is thrown.
function ensureAmoAccessToken_() {
  var access = scriptProperties.getProperty('Amo_Access_token');
  var expiresAt = Number(scriptProperties.getProperty('Amo_Access_token_expires_at') || 0);

  var now = Math.floor(Date.now() / 1000);
  var SKEW = 60;

  if (access && (!expiresAt || (now + SKEW) < expiresAt)) {
    return access;
  }

  var refresh = scriptProperties.getProperty('Amo_Refresh_token');
  if (refresh) {
    return refresh_AccessToken();
  }

  var cfg = getAmoCfg_();

  if (!(cfg.subdomain && cfg.clientId && cfg.clientSecret && cfg.redirectUri && cfg.authCode)) {
    throw new Error(
      'Missing amoCRM config. Нужно задать AMO_SUBDOMAIN, AMO_CLIENT_ID, AMO_CLIENT_SECRET, AMO_REDIRECT_URI, AMO_AUTH_CODE ' +
      '(или объявить константы SUBDOMAIN/CLIENT_ID/CLIENT_SECRET/REDIRECT_URI/Code_authentication).'
    );
  }

  return get_first_AccessToken_return_(cfg.clientId, cfg.clientSecret, cfg.redirectUri, cfg.authCode, cfg.subdomain);
}

// -----------------------------------------------------------------------------
// Helper: Exchange the authorization code for access and refresh tokens
//
// The original get_first_AccessToken() performs the OAuth exchange but
// assumes that CLIENT_ID, CLIENT_SECRET, Code_authentication and
// REDIRECT_URI are available as constants. This new version accepts the
// parameters explicitly and returns the access token. It also writes both
// tokens into the standard properties (Amo_Access_token and Amo_Refresh_token).
function get_first_AccessToken_return_(clientId, clientSecret, redirectUri, authorizationCode, subdomain) {
  if (!subdomain) {
    subdomain = getAmoCfg_().subdomain;
  }
  if (!subdomain) throw new Error('SUBDOMAIN/AMO_SUBDOMAIN не задан');

  var tokenUrl = 'https://' + subdomain + '.amocrm.ru/oauth2/access_token';

  var payloadObj = {
    client_id: clientId,
    client_secret: clientSecret,
    grant_type: 'authorization_code',
    code: authorizationCode,
    redirect_uri: redirectUri
  };

  var options = {
    method: 'post',
    muteHttpExceptions: true,
    contentType: 'application/json',
    payload: JSON.stringify(payloadObj)
  };

  var response = UrlFetchApp.fetch(tokenUrl, options);
  var code = response.getResponseCode();
  var body = response.getContentText();

  if (code < 200 || code >= 300) {
    throw new Error('OAuth exchange failed. HTTP ' + code + ' body=' + body);
  }

  var tokenData = JSON.parse(body);
  if (!tokenData.access_token || !tokenData.refresh_token) {
    throw new Error('OAuth exchange: нет access_token/refresh_token. body=' + body);
  }

  scriptProperties.setProperty('Amo_Access_token', tokenData.access_token);
  scriptProperties.setProperty('Amo_Refresh_token', tokenData.refresh_token);

  if (tokenData.expires_in) {
    var expiresAt = Math.floor(Date.now() / 1000) + Number(tokenData.expires_in);
    scriptProperties.setProperty('Amo_Access_token_expires_at', String(expiresAt));
  }

  try { get_Pipilines(tokenData.access_token); } catch (e) { console.warn('get_Pipilines failed: ' + e); }
  try { get_Deal_Custom_fields(tokenData.access_token); } catch (e) { console.warn('get_Deal_Custom_fields failed: ' + e); }
  try { get_Users(tokenData.access_token); } catch (e) { console.warn('get_Users failed: ' + e); }

  return tokenData.access_token;
}


// -----------------------------------------------------------------------------
// Safe refresh token logic
//
// The original refresh_AccessToken() always overwrote the stored
// Amo_Refresh_token regardless of whether the new refresh token was present in
// the response. This safer version only updates the refresh token when it
// exists in the response. It also throws an error when the access token
// cannot be refreshed so that callers can handle it appropriately.
function refresh_AccessToken() {
  var cfg = getAmoCfg_();

  if (!cfg.subdomain) throw new Error('SUBDOMAIN не задан. Задай const SUBDOMAIN или Script Property AMO_SUBDOMAIN');
  if (!cfg.clientId) throw new Error('CLIENT_ID не задан. Задай const CLIENT_ID или Script Property AMO_CLIENT_ID');
  if (!cfg.clientSecret) throw new Error('CLIENT_SECRET не задан. Задай const CLIENT_SECRET или Script Property AMO_CLIENT_SECRET');

  var refreshToken = scriptProperties.getProperty('Amo_Refresh_token');
  if (!refreshToken) throw new Error('Amo_Refresh_token пуст в Script Properties');

  var tokenUrl = 'https://' + cfg.subdomain + '.amocrm.ru/oauth2/access_token';

  var payloadObj = {
    client_id: cfg.clientId,
    client_secret: cfg.clientSecret,
    grant_type: 'refresh_token',
    refresh_token: refreshToken
  };

  var options = {
    method: 'post',
    muteHttpExceptions: true,
    contentType: 'application/json',
    payload: JSON.stringify(payloadObj)
  };

  var response = UrlFetchApp.fetch(tokenUrl, options);
  var code = response.getResponseCode();
  var body = response.getContentText();

  if (code < 200 || code >= 300) {
    throw new Error('refresh_AccessToken failed. HTTP ' + code + ' body=' + body);
  }

  var tokenData = JSON.parse(body);
  if (!tokenData.access_token) {
    throw new Error('refresh_AccessToken: в ответе нет access_token. body=' + body);
  }

  scriptProperties.setProperty('Amo_Access_token', tokenData.access_token);

  if (tokenData.refresh_token) {
    scriptProperties.setProperty('Amo_Refresh_token', tokenData.refresh_token);
  }

  if (tokenData.expires_in) {
    var expiresAt = Math.floor(Date.now() / 1000) + Number(tokenData.expires_in);
    scriptProperties.setProperty('Amo_Access_token_expires_at', String(expiresAt));
  }

  try { get_Pipilines(tokenData.access_token); } catch (e) { console.warn('get_Pipilines failed: ' + e); }
  try { get_Deal_Custom_fields(tokenData.access_token); } catch (e) { console.warn('get_Deal_Custom_fields failed: ' + e); }
  try { get_Users(tokenData.access_token); } catch (e) { console.warn('get_Users failed: ' + e); }

  return tokenData.access_token;
}



// -----------------------------------------------------------------------------
// Updated get_Deals with safe token retrieval, cache handling and lock cleanup
//
// This version of get_Deals uses ensureAmoAccessToken_() to obtain a valid
// access token. It also checks that cached arrays exist before attempting
// to iterate through them. Missing caches are populated on the fly via
// get_Pipilines() and get_Users(). The entire body of the function is
// wrapped in try/finally to guarantee that any acquired lock is released
// even if an error occurs.
function get_Deals(eventTrigger, num_page_part_start) {
  if (num_page_part_start === undefined) {
    num_page_part_start = Number(scriptProperties.getProperty('Amo_get_Deals_next_part')) || 1;
  }

  var name_function = new Error().stack.match(/at\s+([^\s\(]+)/)[1];
  trigger_delete_by_name('get_Deals_triger');

  // If a lock already exists, abort
  if (isLocked_('lock_key_' + name_function)) {
    console.error('Стоит блокировка запуска дубликата');
    return;
  }

  // Acquire lock for 6 minutes
  setLock_('lock_key_' + name_function, 6);

  try {
    var num_by_part = 2;
    var first_PAGE_NUMBER = (num_page_part_start * num_by_part) - 1;
    var PAGE_NUMBER = first_PAGE_NUMBER;
    var RESULTS_PER_PAGE = 250;
    var all_num_pages = Number(scriptProperties.getProperty('Amo_Pages_' + name_function)) || 0;

    // Obtain a valid access token using the helper
    var Access_token;
    try {
      Access_token = ensureAmoAccessToken_();
      var cfg = getAmoCfg_();
      if (!cfg.subdomain) throw new Error('SUBDOMAIN/AMO_SUBDOMAIN не задан');

    } catch (e) {
      console.error('Ошибка получения токена: ' + e);
      return;
    }

    // Load cached pipelines and users; fallback to empty arrays
    var data_pipelines = JSON.parse(scriptProperties.getProperty('Amo_Data_pipelines') || '[]');
    var data_users = JSON.parse(scriptProperties.getProperty('Amo_Data_users') || '[]');

    // If caches are empty, populate them
    if (data_pipelines.length === 0) {
      get_Pipilines(Access_token);
      data_pipelines = JSON.parse(scriptProperties.getProperty('Amo_Data_pipelines') || '[]');
    }
    if (data_users.length === 0) {
      get_Users(Access_token);
      data_users = JSON.parse(scriptProperties.getProperty('Amo_Data_users') || '[]');
    }

    var map_users = data_users.reduce(function(map, user) {
      map[user[0]] = user[1];
      return map;
    }, {});

    var num_page_part = 1;
    var data_to_sheet = [];
    do {
      if (num_page_part > num_by_part) {
        PAGE_NUMBER = PAGE_NUMBER - 1;
        break;
      }

      var cfg = getAmoCfg_(); // добавь ОДИН раз в начале get_Deals() после токена
      var apiUrl = 'https://' + cfg.subdomain + '.amocrm.ru/api/v4/leads?' +

        'filter[pipeline_id]=' + 6635110 +
        '&filter[created_at][from]=1704060000' +
        '&page=' + PAGE_NUMBER +
        '&limit=' + RESULTS_PER_PAGE +
        '&order[created_at]=asc' +
        '&with=contacts,loss_reason,source_id';

      var options = {
        method: 'get',
        headers: {
          'Authorization': 'Bearer ' + Access_token
        }
      };
      var response;
      response = UrlFetchApp.fetch(apiUrl, options);

        if (response.getResponseCode() === 401) {
          console.warn('401 Unauthorized -> refreshing token...');
          Access_token = refresh_AccessToken();
          options.headers['Authorization'] = 'Bearer ' + Access_token;
          response = UrlFetchApp.fetch(apiUrl, options);
        }


      var content = response.getContentText();
      if (!content) {
        console.error('Ошибка: ответ от сервера пуст!');
        scriptProperties.setProperty('Amo_get_Deals_next_part', 1);
        scriptProperties.setProperty('Amo_Pages_' + name_function, 1);
        break;
      }

      var ApiData = JSON.parse(content);
      var leads = (ApiData._embedded && ApiData._embedded.leads) || [];
      for (var i = 0; i < leads.length; i++) {
        var row_to_sheet = extract_row_field_id_(leads[i], data_pipelines, map_users);
        data_to_sheet.push(row_to_sheet);
      }

      num_page_part++;
      if (ApiData._links && ApiData._links.next) {
        PAGE_NUMBER++;
      } else {
        scriptProperties.setProperty('Amo_get_Deals_next_part', 1);
        scriptProperties.setProperty('Amo_Pages_' + name_function, (Number(PAGE_NUMBER) - 1));
        break;
      }
    } while (true);

    // Sorting, formatting and writing to sheet as before
    data_to_sheet = sort_By_Column_(data_to_sheet, 1, 1);
    var column_convert_number = [7, 14];
    for (var rowIndex = 0; rowIndex < data_to_sheet.length; rowIndex++) {
      for (var idx = 0; idx < column_convert_number.length; idx++) {
        var colIndex = column_convert_number[idx];
        var cell = data_to_sheet[rowIndex][colIndex];
        if (Number(cell) > 0) {
          data_to_sheet[rowIndex][colIndex] = String(cell).replace('.', ',');
        }
      }
    }
    var column_convert_date = [[1, 1], [2, 1], [15, 0]];
    for (var r = 0; r < data_to_sheet.length; r++) {
      for (var j = 0; j < column_convert_date.length; j++) {
        var col = column_convert_date[j][0];
        var includeTime = column_convert_date[j][1];
        data_to_sheet[r][col] = convertUnixTimeToNormalDate_(data_to_sheet[r][col], includeTime);
      }
    }
    var dlina = data_to_sheet.length;
    var shirina = getMaxWidth(data_to_sheet);
    if (dlina > 0) {
      var sheet1 = SpreadsheetApp.getActive().getSheetByName('Сделки');
      var max_dlina = RESULTS_PER_PAGE * num_by_part;
      var row_to_set = ((RESULTS_PER_PAGE * (first_PAGE_NUMBER - 1)) + 2);
      sheet1.getRange(row_to_set, 1, dlina, shirina).setValues(data_to_sheet);
      if (dlina < max_dlina) {
        var startRowToClear = row_to_set + dlina;
        var numRowsToClear = max_dlina - dlina;
        sheet1.getRange(startRowToClear, 1, numRowsToClear, shirina).clearContent();
      }
      scriptProperties.setProperty('Amo_get_Deals_next_part', Number(num_page_part_start) + 1);
    } else {
      scriptProperties.setProperty('Amo_get_Deals_next_part', 1);
      scriptProperties.setProperty('Amo_Pages_' + name_function, 1);
    }
    SpreadsheetApp.flush();
    var updatedAllNumPages = Number(scriptProperties.getProperty('Amo_Pages_' + name_function)) || 0;
    sheet_history.appendRow([name_function, new Date(), num_page_part_start + '/' + Math.ceil((updatedAllNumPages / num_by_part))]);
  } finally {
    // Always release the lock in a finally block
    releaseLock_('lock_key_' + name_function);
  }
}



function get_Deals_multiPipelines(eventTrigger, num_page_part_start) {
  var name_function = 'get_Deals_multiPipelines';

  // Удаляем/гасим возможный старый триггер (если есть такая логика)
  try { trigger_delete_by_name('get_Deals_triger'); } catch (e) {}

  // Защита от дублей запуска
  if (isLocked_('lock_key_' + name_function)) {
    console.error('Стоит блокировка запуска дубликата');
    return;
  }

  // Ставим блокировку на 6 минут
  setLock_('lock_key_' + name_function, 6);

  try {
    // ==========================
    // НАСТРОЙКИ
    // ==========================
    var RESULTS_PER_PAGE = 250;
    var SAFETY_WINDOW_SEC = 120; // 2 минуты "зазор" чтобы не пропустить обновления на границе

    // общий лимит на весь запуск (а не на каждую воронку)
    var startedAt = Date.now();
    var MAX_RUNTIME_MS = 4.5 * 60 * 1000; // 4.5 минуты — безопасно
    var finishedAll = true;               // если остановились по времени — не обновляем lastSync

    // ==========================
    // ТОКЕН
    // ==========================
    var Access_token;
    try {
      Access_token = ensureAmoAccessToken_();
    } catch (e) {
      console.error('Ошибка получения токена: ' + e);
      return;
    }

    // ==========================
    // LAST SYNC (для недублирования)
    // ==========================
    var lastSyncKey = 'Amo_multi_last_sync_ts';
    var lastSync = Number(scriptProperties.getProperty(lastSyncKey) || 0);

    // Если это первый запуск — заберём изменения за последние 7 дней
    if (!lastSync) {
      lastSync = Math.floor(Date.now() / 1000) - 7 * 24 * 60 * 60;
    }

    var updatedFrom = Math.max(0, lastSync - SAFETY_WINDOW_SEC);
    console.log('updated_from=' + updatedFrom + ' (' + new Date(updatedFrom * 1000).toLocaleString('ru') + ')');

    // ==========================
    // КЕШИ (воронки, юзеры)
    // ==========================
    var data_pipelines = JSON.parse(scriptProperties.getProperty('Amo_Data_pipelines') || '[]');
    var data_users = JSON.parse(scriptProperties.getProperty('Amo_Data_users') || '[]');

    if (data_pipelines.length === 0) {
      get_Pipilines(Access_token);
      data_pipelines = JSON.parse(scriptProperties.getProperty('Amo_Data_pipelines') || '[]');
    }
    if (data_users.length === 0) {
      get_Users(Access_token);
      data_users = JSON.parse(scriptProperties.getProperty('Amo_Data_users') || '[]');
    }

    var map_users = data_users.reduce(function (map, user) {
      map[user[0]] = user[1];
      return map;
    }, {});

    // ==========================
    // ЛИСТ НАЗНАЧЕНИЯ
    // ==========================
    var sheet1 = SpreadsheetApp.getActive().getSheetByName('Сделки. Доп воронки');
    if (!sheet1) {
      throw new Error("Лист 'Сделки. Доп воронки' не найден. Создай вкладку с таким названием.");
    }

    // ==========================
    // ГЛАВНЫЙ ЦИКЛ ПО ВОРОНКАМ
    // ==========================
    PIPELINES:
    for (var p = 0; p < MULTI_PIPELINE_IDS.length; p++) {
      var pipelineId = MULTI_PIPELINE_IDS[p];
      console.log('--- Pipeline: ' + pipelineId + ' ---');

      var PAGE_NUMBER = 1;

      // Собираем пачку по pipeline за этот запуск
      var data_to_sheet = [];

      while (true) {
        // предохранитель по времени (общий на весь запуск)
        if (Date.now() - startedAt > MAX_RUNTIME_MS) {
          console.warn('Stop by time limit, will continue next run');
          finishedAll = false;
          break; // выходим из while
        }

        var apiUrl =
          'https://' + SUBDOMAIN + '.amocrm.ru/api/v4/leads?' +
          'filter[pipeline_id]=' + pipelineId +
          '&filter[updated_at][from]=' + updatedFrom +
          '&page=' + PAGE_NUMBER +
          '&limit=' + RESULTS_PER_PAGE +
          '&order[updated_at]=asc' +
          '&with=contacts,loss_reason,source_id';

        var options = {
          method: 'get',
          muteHttpExceptions: true,
          headers: { 'Authorization': 'Bearer ' + Access_token }
        };

        var response = UrlFetchApp.fetch(apiUrl, options);

        if (response.getResponseCode() === 401) {
          console.warn('401 Unauthorized, refreshing token...');
          Access_token = refresh_AccessToken();
          options.headers['Authorization'] = 'Bearer ' + Access_token;
          response = UrlFetchApp.fetch(apiUrl, options);
        }

        var content = response.getContentText();
        if (!content) {
          console.error('Ответ от сервера пуст. Pipeline=' + pipelineId + ', page=' + PAGE_NUMBER);
          break;
        }

        var ApiData;
        try {
          ApiData = JSON.parse(content);
        } catch (e) {
          console.error('Не смог распарсить JSON. Pipeline=' + pipelineId + ', page=' + PAGE_NUMBER + ', body=' + content);
          break;
        }

        var leads = (ApiData._embedded && ApiData._embedded.leads) ? ApiData._embedded.leads : [];
        console.log('Pipeline ' + pipelineId + ': page ' + PAGE_NUMBER + ' leads=' + leads.length);

        for (var i = 0; i < leads.length; i++) {
          var row = extract_row_field_id_(leads[i], data_pipelines, map_users);
          data_to_sheet.push(row);
        }

        // Если следующей страницы нет — выходим
        if (!(ApiData._links && ApiData._links.next)) {
          break;
        }

        PAGE_NUMBER++;
      }

      // Если остановились по времени — выходим из цикла по воронкам
      if (!finishedAll) break PIPELINES;

      // ==========================
      // ФОРМАТИРОВАНИЕ И ЗАПИСЬ
      // ==========================
      if (data_to_sheet.length > 0) {
        // сортировка по ID сделки (как у тебя)
        data_to_sheet = sort_By_Column_(data_to_sheet, 1, 1);

        // числа -> строка с запятой
        var column_convert_number = [7, 14];
        for (var rowIndex = 0; rowIndex < data_to_sheet.length; rowIndex++) {
          for (var idx = 0; idx < column_convert_number.length; idx++) {
            var colIndex = column_convert_number[idx];
            var cell = data_to_sheet[rowIndex][colIndex];
            if (Number(cell) > 0) {
              data_to_sheet[rowIndex][colIndex] = String(cell).replace('.', ',');
            }
          }
        }

        // даты unix -> ru date
        var column_convert_date = [[1, 1], [2, 1], [15, 0]];
        for (var r = 0; r < data_to_sheet.length; r++) {
          for (var j = 0; j < column_convert_date.length; j++) {
            var col = column_convert_date[j][0];
            var includeTime = column_convert_date[j][1];
            data_to_sheet[r][col] = convertUnixTimeToNormalDate_(data_to_sheet[r][col], includeTime);
          }
        }

        var dlina = data_to_sheet.length;

        // UPSERT: обновление существующих + добавление новых
        upsertDealsById_(sheet1, data_to_sheet);

        console.log('Upserted ' + dlina + ' rows for pipeline ' + pipelineId);
      } else {
        console.log('No updates for pipeline ' + pipelineId + ' since lastSync');
      }
    }

    SpreadsheetApp.flush();

    // ==========================
    // ОБНОВЛЯЕМ LAST SYNC ТОЛЬКО ЕСЛИ УСПЕЛИ ПРОЙТИ ВСЕ ВОРОНКИ
    // ==========================
    if (finishedAll) {
      scriptProperties.setProperty(lastSyncKey, String(Math.floor(Date.now() / 1000)));
    } else {
      console.warn('Not updating lastSync because run was cut by time limit');
    }

    // История запусков (если sheet_history есть)
    try {
      sheet_history.appendRow([name_function, new Date(), 'pipelines=' + MULTI_PIPELINE_IDS.length, 'updated_from=' + updatedFrom, 'finishedAll=' + finishedAll]);
    } catch (e) {}

  } finally {
    // Всегда снимаем блокировку
    releaseLock_('lock_key_' + name_function);
  }
}


function upsertDealsById_(sheet, rows) {
  if (!rows || !rows.length) return;

  // ВАЖНО: считаем, что ID сделки у тебя в колонке A (index 0 в массиве)
  var ID_COL_INDEX = 0;
  var HEADER_ROWS = 1; // строка 1 — заголовки, данные с 2-й

  // Считываем все текущие ID из листа
  var lastRow = sheet.getLastRow();
  var existing = {};
  if (lastRow > HEADER_ROWS) {
    var ids = sheet.getRange(HEADER_ROWS + 1, 1, lastRow - HEADER_ROWS, 1).getValues(); // колонка A
    for (var i = 0; i < ids.length; i++) {
      var id = String(ids[i][0] || '').trim();
      if (id) existing[id] = HEADER_ROWS + 1 + i; // номер строки на листе
    }
  }

  // Разбиваем на обновления и новые
  var updates = []; // {rowNumber, values}
  var inserts = []; // values[]

  for (var r = 0; r < rows.length; r++) {
    var dealId = String(rows[r][ID_COL_INDEX] || '').trim();
    if (!dealId) continue;

    if (existing[dealId]) {
      updates.push({ rowNumber: existing[dealId], values: rows[r] });
    } else {
      inserts.push(rows[r]);
    }
  }

  // 1) Обновляем существующие (перезаписываем строку целиком) пачками последовательных строк
  if (updates.length) {
    updates.sort(function(a, b){ return a.rowNumber - b.rowNumber; });

    var start = updates[0].rowNumber;
    var batch = [updates[0].values];

    for (var u = 1; u < updates.length; u++) {
      var rn = updates[u].rowNumber;
      if (rn === start + batch.length) {
        batch.push(updates[u].values);
      } else {
        sheet.getRange(start, 1, batch.length, batch[0].length).setValues(batch);
        start = rn;
        batch = [updates[u].values];
      }
    }
    sheet.getRange(start, 1, batch.length, batch[0].length).setValues(batch);
  }

  // 2) Добавляем новые в конец
  if (inserts.length) {
    var startRow = sheet.getLastRow() + 1;
    sheet.getRange(startRow, 1, inserts.length, inserts[0].length).setValues(inserts);
  }
}
