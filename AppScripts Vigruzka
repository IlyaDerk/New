// --- Unified lock with TTL marker (never "stuck forever")
function withLock_(name, fn) {
  var lock = LockService.getScriptLock();
  var tsKey = 'LOCK_' + name + '_TS';
  var ttlMs = 15 * 60 * 1000; // 15 minutes safety TTL

  // TTL marker cleanup
  var prev = Number(scriptProperties.getProperty(tsKey) || 0);
  if (prev && (Date.now() - prev > ttlMs)) {
    scriptProperties.deleteProperty(tsKey);
  }

  var acquired = false;
  try {
    acquired = lock.tryLock(30 * 1000); // 30s
    if (!acquired) {
      console.warn('[' + name + '] lock not acquired, skip run');
      return;
    }
    scriptProperties.setProperty(tsKey, String(Date.now()));
    return fn();
  } finally {
    // Always remove marker and release lock
    scriptProperties.deleteProperty(tsKey);
    if (acquired) {
      try { lock.releaseLock(); } catch (e) { console.warn('[' + name + '] releaseLock failed: ' + e); }
    }
  }
}

// --- Token helpers
function saveTokens_(tokenData) {
  // expires_in is seconds
  var expiresAt = Date.now() + (Number(tokenData.expires_in || 0) * 1000);

  var props = {
    Amo_Access_token: tokenData.access_token,
    Amo_Access_token_expires_at: String(expiresAt)
  };

  // refresh_token may be absent in some responses; keep old if missing
  if (tokenData.refresh_token) props.Amo_Refresh_token = tokenData.refresh_token;

  scriptProperties.setProperties(props, true);
}

function ensureAmoAccessToken_() {
  var access = scriptProperties.getProperty('Amo_Access_token');
  var refresh = scriptProperties.getProperty('Amo_Refresh_token');
  var expAt = Number(scriptProperties.getProperty('Amo_Access_token_expires_at') || 0);

  // 60s buffer
  if (access && expAt && Date.now() < (expAt - 60 * 1000)) {
    return access;
  }

  if (refresh) {
    return refresh_AccessToken(); // overridden below
  }

  // fallback to one-time auth code
  var cfg = amoCfg_();
  if (cfg.authCode) {
    return get_first_AccessToken(); // overridden below
  }

  throw new Error('No valid amoCRM tokens. Set AMO_AUTH_CODE (one-time) to bootstrap.');
}

// --- Low-level HTTP (returns {code,text,json})
function amoFetch_(method, url, options) {
  options = options || {};
  var params = {
    method: method,
    muteHttpExceptions: true,
    headers: options.headers || {}
  };
  if (options.payload != null) {
    params.contentType = options.contentType || 'application/json';
    params.payload = (typeof options.payload === 'string') ? options.payload : JSON.stringify(options.payload);
  }

  var r = UrlFetchApp.fetch(url, params);
  var code = r.getResponseCode();
  var text = r.getContentText();

  var json = null;
  try { json = text ? JSON.parse(text) : null; } catch (e) {}

  return { code: code, text: text, json: json };
}

// --- Unified amo request with retries for 401/429
function amoRequestJson_(method, url, options) {
  options = options || {};
  var max429 = 3;

  var token = ensureAmoAccessToken_();
  options.headers = options.headers || {};
  options.headers.Authorization = 'Bearer ' + token;

  var resp = amoFetch_(method, url, options);

  // If unauthorized, refresh and retry once
  if (resp.code === 401) {
    token = refresh_AccessToken();
    options.headers.Authorization = 'Bearer ' + token;
    resp = amoFetch_(method, url, options);
  }

  // Rate limit retries
  var tries = 0;
  while (resp.code === 429 && tries < max429) {
    tries++;
    Utilities.sleep(1000 * tries);
    token = ensureAmoAccessToken_();
    options.headers.Authorization = 'Bearer ' + token;
    resp = amoFetch_(method, url, options);
  }

  if (resp.code < 200 || resp.code >= 300) {
    throw new Error('amoRequest failed ' + resp.code + ': ' + resp.text);
  }

  return resp.json;
}

