// 1) Функция для получения токена - используется 1 раз
function get_first_AccessToken() {

  const tokenUrl = 'https://' + SUBDOMAIN + '.amocrm.ru/oauth2/access_token';

  const payload = {
    client_id: CLIENT_ID,
    client_secret: CLIENT_SECRET,
    grant_type: 'authorization_code',
    code: Code_authentication,
    redirect_uri: REDIRECT_URI
  };

  const options = {
    method: 'post',
    contentType: 'application/x-www-form-urlencoded',
    payload: Object.keys(payload).map(key => encodeURIComponent(key) + '=' + encodeURIComponent(payload[key])).join('&')
  };

  const response = UrlFetchApp.fetch(tokenUrl, options);
  const tokenData = JSON.parse(response.getContentText());

  console.log(tokenData)
  scriptProperties.setProperty('Amo_Access_token', tokenData.access_token);
  scriptProperties.setProperty('Amo_Refresh_token', tokenData.refresh_token);

  get_Pipilines(tokenData.access_token) // Сохранить в кеш данные по ворокам
  get_Deal_Custom_fields(tokenData.access_token) // Сохранить в кеш данные по пользовательским полям
  get_Users(tokenData.access_token)
  //  get_Contacts(tokenData.access_token)
  //  get_Companies(tokenData.access_token)
}


// 2) Функция для обновления токена - используется раз в 24 часа
function refresh_AccessToken() {
  // --- Безопасное получение конфига: сначала из глобальных констант, иначе из Script Properties
  function pick_(globalName, propKey) {
    try {
      if (typeof globalThis !== 'undefined' && typeof globalThis[globalName] !== 'undefined' && globalThis[globalName] !== null) {
        return globalThis[globalName];
      }
    } catch (e) {}
    return scriptProperties.getProperty(propKey);
  }

  var subdomain = pick_('SUBDOMAIN', 'AMO_SUBDOMAIN');
  var clientId = pick_('CLIENT_ID', 'AMO_CLIENT_ID');
  var clientSecret = pick_('CLIENT_SECRET', 'AMO_CLIENT_SECRET');

  if (!subdomain) throw new Error('SUBDOMAIN не задан. Либо объяви const SUBDOMAIN, либо задай Script Property AMO_SUBDOMAIN');
  if (!clientId) throw new Error('CLIENT_ID не задан. Либо объяви const CLIENT_ID, либо задай Script Property AMO_CLIENT_ID');
  if (!clientSecret) throw new Error('CLIENT_SECRET не задан. Либо объяви const CLIENT_SECRET, либо задай Script Property AMO_CLIENT_SECRET');

  var refreshToken = scriptProperties.getProperty('Amo_Refresh_token');
  if (!refreshToken) throw new Error('Amo_Refresh_token пуст в Script Properties');

  var tokenUrl = 'https://' + subdomain + '.amocrm.ru/oauth2/access_token';

  var payloadObj = {
    client_id: clientId,
    client_secret: clientSecret,
    grant_type: 'refresh_token',
    refresh_token: refreshToken
  };

  var options = {
    method: 'post',
    muteHttpExceptions: true,
    contentType: 'application/x-www-form-urlencoded',
    payload: Object.keys(payloadObj)
      .map(function (key) { return encodeURIComponent(key) + '=' + encodeURIComponent(payloadObj[key]); })
      .join('&')
  };

  var response = UrlFetchApp.fetch(tokenUrl, options);
  var code = response.getResponseCode();
  var body = response.getContentText();

  if (code < 200 || code >= 300) {
    // amoCRM обычно возвращает JSON с описанием ошибки
    throw new Error('refresh_AccessToken failed. HTTP ' + code + ' body=' + body);
  }

  var tokenData;
  try {
    tokenData = JSON.parse(body);
  } catch (e) {
    throw new Error('refresh_AccessToken: не смог распарсить JSON. body=' + body);
  }

  if (!tokenData.access_token) {
    throw new Error('refresh_AccessToken: в ответе нет access_token. body=' + body);
  }

  // Сохраняем новые токены
  scriptProperties.setProperty('Amo_Access_token', tokenData.access_token);
  if (tokenData.refresh_token) {
    scriptProperties.setProperty('Amo_Refresh_token', tokenData.refresh_token);
  }

  // Обновление кешей — НЕ должно ломать refresh, поэтому в try/catch
  try { get_Pipilines(tokenData.access_token); } catch (e) { console.warn('get_Pipilines failed: ' + e); }
  try { get_Deal_Custom_fields(tokenData.access_token); } catch (e) { console.warn('get_Deal_Custom_fields failed: ' + e); }
  try { get_Users(tokenData.access_token); } catch (e) { console.warn('get_Users failed: ' + e); }

  return tokenData.access_token;
}





