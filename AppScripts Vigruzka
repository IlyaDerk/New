function sort_By_Column_(data, columnIndex, direction = 1) { // Направление сортировки (1 для возрастания, 0 для убывания).
  // Вычитаем 1, чтобы учесть, что входной индекс столбца начинается с 1
  const index = columnIndex - 1;

  return data.sort((a, b) => {
    if (a[index] < b[index]) {
      return direction === 1 ? -1 : 1;
    }
    if (a[index] > b[index]) {
      return direction === 1 ? 1 : -1;
    }
    return 0; // равные значения
  });
}


function getEndOfDayUnix_() {
  var now = new Date(); // получаем текущую дату и время
  now.setHours(23, 59, 59, 999); // устанавливаем время до конца дня

  // Конвертируем дату в миллисекунды (время в формате Unix, но в миллисекундах)
  var timeInMs = now.getTime();

  // Конвертируем миллисекунды в секунды (стандартное время в формате Unix)
  var unixTimestamp = timeInMs / 1000;

  return unixTimestamp;
}


